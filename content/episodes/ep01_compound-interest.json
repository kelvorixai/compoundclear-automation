  "segments": [
    {
      "id": 1,
      "text": "Everyone says time in the market beats timing the market. Here's the part nobody explains: why.",
      "slide": {
        "type": "statement"
      }
    },
    {
      "id": 2,
      "text": "It's not really about time. It's about how compound growth curves, and that curve gets dramatically steeper the longer you leave it alone.",
      "slide": {
        "type": "statement"
      }
    },
    {
      "id": 3,
      "text": "Take ten thousand dollars, growing at a steady seven percent a year. No new money added, just left alone.",
      "slide": {
        "type": "statement"
